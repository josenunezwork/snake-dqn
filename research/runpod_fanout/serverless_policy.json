{
  "schema": "runpod-fanout-serverless-policy/v1",
  "approved": "user chat 2026-10-03: serverless CPU workers via a PRIVATE network volume (git archive + allow-listed checkpoints only, public base image), cpu5c preferred then cpu3c, one CPU model per run; serverless is the default backend for Tier-1 CPU jobs (pods = --backend pods)",
  "flavors_pref": ["cpu5c", "cpu3c"],
  "usd_per_vcpu_hr": {"cpu5c": 0.042, "cpu3c": 0.036},
  "price_margin": 1.25,
  "data_center": "EU-RO-1",
  "image": "python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016",
  "mount": "/runpod-volume",
  "root_dir": "rpf",
  "volume_name": "rpf-sls-eu-ro-1",
  "volume_size_gb": 5,
  "volume_usd_per_gb_month": 0.07,
  "container_disk_gb": 10,
  "vcpu_sizes": [32, 16, 8, 4, 2],
  "max_workers": 30,
  "max_endpoint_hourly_usd": 15.0,
  "idle_timeout_seconds": 5,
  "scaler_type": "REQUEST_COUNT",
  "scaler_value": 1,
  "cold_start_seconds_est": 150,
  "startup_deadline_seconds": 900,
  "poll_seconds": 15,
  "inflight_jobs_per_worker": 1.5,
  "max_cpu_model_refusals": 40,
  "target_wall_minutes": 30,
  "max_target_wall_minutes": 60,
  "endpoint_prefix": "rpf-sls-",
  "template_prefix": "rpf-sls-rt-",
  "handler_pip": [["install", "-q", "--no-cache-dir", "runpod==1.12.0"]],
  "handler_import": "runpod",
  "seeder": {"flavor": "cpu5c", "vcpu": 2, "max_hourly_usd": 0.2, "max_wall_minutes": 45}
}
