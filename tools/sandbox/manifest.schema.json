{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standing A100 Development Sandbox manifest",
  "type": "object",
  "required": ["schema", "study", "inputs", "salt", "endpoint", "timeout", "excluded_studies", "owner_rule", "outputs", "crossing"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "standing-a100-development-sandbox/v1"},
    "study": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "minItems": 1},
    "salt": {"type": "string", "pattern": "^a100-dev/"},
    "endpoint": {"type": "object"},
    "timeout": {"type": "object"},
    "excluded_studies": {"type": "array", "minItems": 1},
    "owner_rule": {"type": "string", "minLength": 1},
    "outputs": {"type": "object"},
    "crossing": {"type": "object"}
  }
}
