      "channels": [
        {
          "index": 0,
          "name": "wall_occupancy",
          "rule": "1.0 (65535) if occupied by any living snake segment, 0.0 (0) if free; conv pads exterior border with 1.0 (wall)."
        },
        {
          "index": 1,
          "name": "own_ttl",
          "rule": "clamp(own_ttl_steps(y, x) / max(1, hero_length), 0.0, 1.0) where own_ttl_steps = max(0, hero_length - hero_seg_count) + (hero_seg_count - k); hero head has 1.0 (65535), empty 0.0."
        },
        {
          "index": 2,
          "name": "enemy_ttl",
          "rule": "clamp(max_{s in 1..5 alive} enemy_ttl_steps(s, y, x) / 1000.0, 0.0, 1.0), empty 0.0."
        },
        {
